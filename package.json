{
  "name": "five-glm",
  "version": "1.0.0",
  "private": true,
  "description": "五子棋跨端游戏（H5 网页版 + 各小程序）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "react"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:qq": "taro build --type qq",
    "build:swan": "taro build --type swan",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.4",
    "ios >= 9"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-alipay": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-qq": "4.2.1",
    "@tarojs/plugin-platform-swan": "4.2.1",
    "@tarojs/plugin-platform-tt": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@tarojs/cli": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/test-utils-react": "^0.1.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.1",
    "@types/webpack-env": "^1.18.4",
    "babel-preset-taro": "4.2.1",
    "html-webpack-plugin": "^5.6.8",
    "postcss": "^8.4.38",
    "react-refresh": "^0.14.0",
    "sass": "^1.72.0",
    "sass-loader": "^14.1.1",
    "style-loader": "^3.3.4",
    "stylelint": "^16.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0",
    "webpack": "^5.91.0"
  }
}
